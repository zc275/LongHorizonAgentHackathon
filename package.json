{
  "name": "nursery-activity-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "verify:demo": "tsx scripts/verify-demo.ts"
  },
  "dependencies": {
    "@nimble-way/nimble-js": "^1.5.0",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "latest",
    "dotenv": "^18.0.4",
    "express": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^3.2.4"
  }
}
