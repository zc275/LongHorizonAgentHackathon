# Add your Nimble API key to .env for live, source-linked alert research.
NIMBLE_API_KEY=

# Tinybird append token. Use a token with DATASOURCE:APPEND scope.
TINYBIRD_TOKEN=
# Optional workspace-specific API host, data source name defaults to nightwatch_state_changes.
TINYBIRD_API_URL=
TINYBIRD_DATASOURCE=
